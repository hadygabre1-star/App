name: Build Android APK

on:
  push:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Find and Build with Gradle
        run: |
          if [ -f "gradlew" ]; then
            chmod +x gradlew
            ./gradlew assembleDebug
          else
            echo "Searching for gradlew in subdirectories..."
            find . -name "gradlew" -exec chmod +x {} \;
            GRADLE_PATH=$(find . -name "gradlew" | head -n 1)
            if [ -n "$GRADLE_PATH" ]; then
              DIR_PATH=$(dirname "$GRADLE_PATH")
              cd "$DIR_PATH"
              ./gradlew assembleDebug
            else
              echo "Error: gradlew not found anywhere in repository."
              exit 1
            fi
          fi

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-debug
          path: '**/app-debug.apk'
